{
  "name": "@nullsquare/agent-authority",
  "version": "0.3.0",
  "description": "Mission-scoped authorization, credential isolation and delegated authority runtime for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "keywords": [
    "ai-agent-authorization",
    "agent-auth",
    "agent-security",
    "delegated-authorization",
    "oauth",
    "mcp",
    "model-context-protocol",
    "credential-broker",
    "coding-agents",
    "llm-agents",
    "human-in-the-loop",
    "agent-permissions",
    "agentic-ai-security"
  ],
  "bin": {
    "agent-authority": "src/cli.js",
    "aauth": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js serve",
    "setup": "node src/cli.js setup",
    "doctor": "node src/cli.js doctor",
    "demo": "node examples/demo.js",
    "demo:mcp-upstream": "node examples/validation-mcp-upstream.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "check:syntax": "node --check src/index.js && node --check src/connections.js && node --check src/execution.js && node --check src/providers/github.js && node --check src/storage.js && node --check src/runtime-env.js && node --check src/sdk.js && node --check src/server.js && node --check src/cli.js && node --check src/agent-auth.js && node --check src/approvals.js && node --check src/idempotency.js && node --check src/keys.js && node --check src/harness-bridge.js && node --check src/mcp-gateway.js && node --check src/mcp-remote.js && node --check src/mcp-server.js && node --check examples/validation-mcp-upstream.js",
    "check:package": "npm pack --dry-run",
    "check": "npm run check:syntax && npm test && npm run check:package"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "engines": { "node": ">=20" },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./agent-auth": "./src/agent-auth.js",
    "./approvals": "./src/approvals.js",
    "./connections": "./src/connections.js",
    "./execution": "./src/execution.js",
    "./harness-bridge": "./src/harness-bridge.js",
    "./idempotency": "./src/idempotency.js",
    "./mcp-gateway": "./src/mcp-gateway.js",
    "./mcp-remote": "./src/mcp-remote.js",
    "./mcp-server": "./src/mcp-server.js",
    "./sdk": "./src/sdk.js",
    "./storage": "./src/storage.js",
    "./providers/github": "./src/providers/github.js"
  },
  "files": ["src", "docs", "examples", "README.md", "LICENSE", "SECURITY.md", "ROADMAP.md", "CONTRIBUTING.md"],
  "repository": { "type": "git", "url": "git+https://github.com/Null-Square/agent-authority.git" },
  "bugs": { "url": "https://github.com/Null-Square/agent-authority/issues" },
  "homepage": "https://github.com/Null-Square/agent-authority#readme"
}
